{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dashy",
  "version": "0.1.0",
  "identifier": "app.dashy.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dashy",
        "width": 70,
        "height": 270,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Dashy Settings",
        "width": 460,
        "height": 620,
        "visible": false,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": { "active": true, "targets": "all" }
}
